RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Optional first administrator bootstrap (use npm run create-admin once).
ADMIN_NAME=Hotel Administrator
ADMIN_EMAIL=
ADMIN_PASSWORD=
